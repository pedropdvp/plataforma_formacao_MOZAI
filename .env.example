# Clerk Authentication Configuration
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Após o login, entrar directamente na plataforma. O layout do dashboard reencaminha para
# /choose-role enquanto não houver perfil activo válido (cookie "active-role").
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
# Desliga a telemetria que os SDKs do Clerk enviam enquanto a instância é de desenvolvimento
# (a mensagem "Attention: Clerk collects telemetry data" nos registos). Lida no servidor e no browser.
NEXT_PUBLIC_CLERK_TELEMETRY_DISABLED=1

# Deployment / Multi-tenancy
# Domínio base a partir do qual o proxy extrai o subdomínio = tenant.
# Local: não é usado (detecta localhost). Vercel: o host de produção
# (plataforma-formacao-mozai.vercel.app). Produção final: mozai.education
NEXT_PUBLIC_BASE_DOMAIN=mozai.education

# WorkOS B2B SSO Configuration
WORKOS_API_KEY=key_test_...
WORKOS_CLIENT_ID=client_...

# Database Persistance
MONGODB_URI=mongodb+srv://...
MONGODB_DB=mozai_db

# Sanity Headless CMS Configuration
SANITY_PROJECT_ID=project_id...
SANITY_DATASET=production
# Necessários para o Studio embutido em /studio (expostos ao browser):
NEXT_PUBLIC_SANITY_PROJECT_ID=project_id...
NEXT_PUBLIC_SANITY_DATASET=production
# Token de ESCRITA (permissão Editor) — usado pelos scripts de seed. NUNCA expor ao browser:
SANITY_API_WRITE_TOKEN=sk...

# OpenAI (embeddings do RAG + Tutor de IA)
OPENAI_API_KEY=sk-...
# Tenant a indexar (default "root")
TENANT_ID=root
# Segredo partilhado do webhook de reindexação Sanity -> /api/sanity-webhook
SANITY_WEBHOOK_SECRET=um-segredo-forte-aqui

# Video & Asset Streaming
MUX_TOKEN_ID=mux_token_...
MUX_TOKEN_SECRET=mux_secret_...
NEXT_PUBLIC_MUX_PLAYBACK_URL=https://stream.mux.com
# Segredo de assinatura do webhook (Mux Dashboard → Settings → Webhooks). Sem ele, o
# /api/admin/media/mux-webhook recusa todas as notificações — o estado dos vídeos continua a
# atualizar-se pela consulta direta ao Mux que o painel de media faz enquanto o upload decorre.
MUX_WEBHOOK_SECRET=...

# Payment & Marketplace split Connect
# Sem uma chave verdadeira, o catálogo corre em modo de demonstração: a compra de cursos avulsos
# passa por um simulador que regista a compra sem cobrar. Com chave, o simulador desliga-se e só o
# webhook do Stripe (/api/stripe/webhook, evento checkout.session.completed) regista compras.
# STRIPE_WEBHOOK_SECRET é o "Signing secret" desse endpoint no painel do Stripe.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Vercel Blob (uploads). São DOIS tokens distintos: o público serve os assets
# consumidos por <img>/<audio>, que não conseguem autenticar-se.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
BLOB_READ_WRITE_TOKEN_PUBLIC=vercel_blob_rw_...

# Segredo que autentica as chamadas dos cron jobs definidos em vercel.json
CRON_SECRET=um-segredo-forte-aqui
# Chave de cifra dos segredos guardados na base de dados (ex.: credenciais de plugins)
SECRETS_ENCRYPTION_KEY=uma-chave-forte-aqui

# ChatBot — todas opcionais, com valor por omissão. Servem para afinar custo sem código.
# Mensagens do histórico enviadas ao modelo; acima disto entra o resumo.
CHATBOT_MAX_HISTORY=12
# Acima de quantas mensagens por resumir se condensa a parte antiga da conversa.
CHATBOT_SUMMARY_TRIGGER=16
# Quantas mensagens recentes ficam sempre fora do resumo.
CHATBOT_SUMMARY_KEEP=8
# Dias que uma resposta em cache continua a ser servida.
CHATBOT_CACHE_TTL_DAYS=30

# Revelação do valor completo das variáveis em Configurações > Variáveis de Ambiente.
# OPCIONAIS: sem elas a página mostra estado e máscara, e o botão "Revelar" não aparece.
# Cada revelação é individual, limitada a uma por minuto e registada em audit_logs.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=prj_...
VERCEL_TEAM_ID=team_...

# Estado dos servidores MCP em Configurações > MCPs.
# O `npm run mcp:check -- --publish` corre na máquina de quem desenvolve, verifica cada
# servidor e envia o resultado para /api/admin/mcp-status com esta chave no cabeçalho
# x-mcp-status-token. Sem ela definida no servidor, a rota responde 503 e a página fica vazia.
# Gerar uma qualquer com pelo menos 16 caracteres: `openssl rand -hex 24`.
MCP_STATUS_TOKEN=
# Para onde o script publica. Em branco, publica para a produção da Vercel.
MCP_STATUS_URL=http://localhost:3000
